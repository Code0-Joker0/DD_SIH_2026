# Template — copy to .env and fill in values for your environment.
# Dev machine:  DATA_ROOT=/mnt/shared_drive   (or /home/<user>/.cache/sih_2026)
# Server:       DATA_ROOT=/data/sih26117

DATA_ROOT=/mnt/shared_drive
HF_HOME=${DATA_ROOT}/hf_cache
QDRANT_STORAGE=${DATA_ROOT}/qdrant_storage
LOG_DIR=${DATA_ROOT}/logs

QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_CONTAINER_NAME=sih-qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=sih_documents

# LLM served by vLLM  (dev: lighter 7B AWQ model; server: full 30B)
VLLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-AWQ
VLLM_HOST=127.0.0.1
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=local-vllm
VLLM_PORT=8000
VLLM_GPU_MEM_UTIL=0.85
VLLM_MAX_MODEL_LEN=8192
VLLM_QUANTIZATION=awq
VLLM_USE_DEEP_GEMM=0

POSTGRES_CONTAINER_NAME=sih-postgres
POSTGRES_DB=sih_db
POSTGRES_USER=sih
POSTGRES_PASSWORD=changeme       # CHANGE THIS — never commit a real password
POSTGRES_PORT=5432
POSTGRES_STORAGE=${DATA_ROOT}/postgre_storage
POSTGRES_URL=postgresql://sih:changeme@localhost:5432/sih_db

# Embedding / reranker models  (cpu on dev, cuda on server)
BGE_M3_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BGE_DEVICE=cpu
RERANKER_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# FastAPI dev server
API_HOST=127.0.0.1
API_PORT=8080
